{
  "name": "slide-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic deck Markdown parser, validator, and deterministic presentation renderer.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@11.9.0",
  "type": "module",
  "bin": {
    "slide": "./bin/slide.mjs"
  },
  "scripts": {
    "slide": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate examples/v1-valid-consulting-deck.md",
    "parse": "tsx src/cli.ts parse examples/v1-valid-consulting-deck.md --out /tmp/slide-deck.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find test -name '*.test.ts' ! -name '*.browser.test.ts' -print)",
    "test:browser": "tsx --test test/**/*.browser.test.ts",
    "audit:public": "node scripts/audit-public-payload.mjs",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run audit:public"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "playwright": "^1.57.0",
    "pptxgenjs": "^4.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
